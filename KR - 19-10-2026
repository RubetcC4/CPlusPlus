        std::cout << "Ощибка\n";
    else std::cout << res << '\n';

    std::cout << "задание 2\n";
    find_dividers(12);

    std::cout << "задание 3\n";
    int square = 0, cube = 0;
    analyze(3, square, cube);
    std::cout << square << ' ' << cube << '\n';
    
    std::cout << "задание 4\n";
    int arr[5] = {1, 5, 2, 6, 3};
    process_array(arr, 5);
}
