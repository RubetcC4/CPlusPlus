#include <iostream>

// Задание 1

int delivery_cost(int mass, int dist) {
    if (mass <= 0 || dist <= 0)
        return 1;
    int res;
    if (mass <= 2) res = 150;
    else res = 250;

    if (dist > 50) res += 100;
    return res;
}

// Задание 2

void find_dividers(int n) {
    int count = 0;
    int sum = 0;
    for (int i = 1; i <= n; ++i)
    {
        if (n % i == 0) {
            std::cout << i << ' ';
            count++;
            sum += i;
        }
    }
    std::cout << '\n' << count << ' ' << sum << '\n';
}

// Задание 3

void analyze(int n, int & square, int & cube) {
    square = n * n;
    cube = n * n * n;
}

// Задание 4

void process_array(int arr[], int size) {
    int peaks = 0;
    
    for (int i = 1; i < size - 1; ++i) {
    peaks += (arr[i] > arr[i - 1] && arr[i] > arr [i + 1]);
}
    int temp = arr[0];
    
    for (int i = 0; i < size - 1; ++i) {
    arr[i] = arr[i + 1]; }
    arr[size - 1] = temp;
    std::cout << peaks << '\n';
    
    for (int i = 0; i < size; ++i)
    std::cout << arr[i] << ' ';
    std::cout << '\n';
}

